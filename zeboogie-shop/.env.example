# ───────── Режим источника товаров ─────────
# demo — тестовый каталог (никогда не смешивается с реальным), live — товары сообщества VK.
VK_MODE=demo

# ───────── ВКонтакте (ТОЛЬКО сервер, префикс NEXT_PUBLIC_ не использовать!) ─────────
# Короткое имя или числовой id сообщества. https://vk.ru/zeboogie -> zeboogie
VK_GROUP=zeboogie
# Токен: сервисный ключ VK-приложения ИЛИ ключ доступа сообщества с правом «Товары» (market).
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199
VK_API_BASE=https://api.vk.com/method
# Домен для публичных ссылок на товары и сообщество.
VK_PUBLIC_DOMAIN=vk.ru

# ───────── Синхронизация ─────────
# Секрет для POST /api/sync (cron, вебхуки). Сгенерируйте: openssl rand -hex 32
SYNC_SECRET=
# Через сколько минут снимок каталога считается устаревшим (фоновая пересинхронизация).
SYNC_TTL_MINUTES=30
# Папка хранилища снимков каталога и журнала синхронизации.
DATA_DIR=./data

# ───────── Заказы ─────────
# Необязательно. Если задано — сервер отправит заказ сообщением от имени сообщества
# этому пользователю VK (нужен ключ СООБЩЕСТВА с правом «Сообщения», и пользователь
# должен разрешить сообщения от сообщества). Без этого заказ оформляется через
# личные сообщения сообщества на стороне покупателя.
ORDER_NOTIFY_VK_USER_ID=

# ───────── Сайт ─────────
SITE_URL=http://localhost:3000
SHOP_NAME=Zeboogie
# Контакты в подвале сайта (необязательно; из VK контакты не берутся).
SHOP_EMAIL=
SHOP_PHONE=
